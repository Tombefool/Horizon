{
  "ai": {
    "provider": "openai",
    "model": "nvidia/nemotron-3-ultra-550b-a55b:free",
    "base_url": "https://openrouter.ai/api/v1",
    "api_key_env": "OPENROUTER_API_KEY",
    "extra_body": {
      "models": [
        "nvidia/nemotron-3-ultra-550b-a55b:free",
        "google/gemma-4-31b-it:free",
        "google/gemma-4-26b-a4b-it:free"
      ]
    },
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 3,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "intel-news",
    "profile_settings": {
      "intel-news": {
        "threshold": 6.5,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 20,
      "min_score": 150,
      "profile": "intel-news"
    },
    "rss": [
      {
        "name": "The Cipher Brief",
        "url": "https://www.thecipherbrief.com/feed",
        "enabled": true,
        "category": "agencies-policy",
        "profile": "intel-news",
        "fetch_limit": 3
      },
      {
        "name": "CISA News",
        "url": "https://www.cisa.gov/news.xml",
        "enabled": true,
        "category": "agencies-policy",
        "profile": "intel-news",
        "fetch_limit": 2
      },
      {
        "name": "NCSC UK News",
        "url": "https://www.ncsc.gov.uk/api/1/services/v1/news-rss-feed.xml",
        "enabled": true,
        "category": "agencies-policy",
        "profile": "intel-news",
        "fetch_limit": 2
      },
      {
        "name": "DefenseScoop",
        "url": "https://defensescoop.com/feed/",
        "enabled": true,
        "category": "agencies-policy",
        "profile": "intel-news",
        "fetch_limit": 2
      },
      {
        "name": "Bellingcat",
        "url": "https://www.bellingcat.com/feed/",
        "enabled": true,
        "category": "osint",
        "profile": "intel-news",
        "fetch_limit": 2
      },
      {
        "name": "The Record",
        "url": "https://therecord.media/feed",
        "enabled": true,
        "category": "threat-intelligence",
        "profile": "intel-news",
        "fetch_limit": 3
      },
      {
        "name": "CyberScoop",
        "url": "https://cyberscoop.com/feed/",
        "enabled": true,
        "category": "threat-intelligence",
        "profile": "intel-news",
        "fetch_limit": 3
      },
      {
        "name": "Unit 42",
        "url": "https://unit42.paloaltonetworks.com/feed/",
        "enabled": true,
        "category": "threat-intelligence",
        "profile": "intel-news",
        "fetch_limit": 2
      },
      {
        "name": "Krebs on Security",
        "url": "https://krebsonsecurity.com/feed/",
        "enabled": true,
        "category": "threat-intelligence",
        "profile": "intel-news",
        "fetch_limit": 1
      },
      {
        "name": "CERT-EU Threat Intelligence",
        "url": "https://cert.europa.eu/publications/threat-intelligence-rss",
        "enabled": true,
        "category": "threat-intelligence",
        "profile": "intel-news",
        "fetch_limit": 1
      },
      {
        "name": "Recorded Future",
        "url": "https://www.recordedfuture.com/feed",
        "enabled": true,
        "category": "commercial-intel",
        "profile": "intel-news",
        "fetch_limit": 2
      },
      {
        "name": "Flashpoint Blog",
        "url": "https://flashpoint.io/blog/feed/",
        "enabled": true,
        "category": "commercial-intel",
        "profile": "intel-news",
        "fetch_limit": 2
      },
      {
        "name": "USGIF",
        "url": "https://usgif.org/feed/",
        "enabled": true,
        "category": "geoint",
        "profile": "intel-news",
        "fetch_limit": 2
      },
      {
        "name": "Via Satellite Government/Military",
        "url": "https://www.satellitetoday.com/government-military/feed/",
        "enabled": true,
        "category": "geoint",
        "profile": "intel-news",
        "fetch_limit": 2
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [],
      "users": [],
      "fetch_comments": 5
    },
    "ossinsight": {
      "enabled": false,
      "period": "past_24_hours",
      "languages": [
        "All"
      ],
      "keywords": [],
      "min_stars": 50,
      "max_items": 4,
      "profile": "intel-news"
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 8,
    "profile_order": [
      "intel-news"
    ],
    "group_by": "category",
    "category_groups": {
      "agencies-policy": {
        "name": "Agencies & Policy",
        "limit": 2,
        "categories": [
          "agencies-policy"
        ]
      },
      "osint": {
        "name": "OSINT",
        "limit": 2,
        "categories": [
          "osint"
        ]
      },
      "threat-intelligence": {
        "name": "Threat Intelligence",
        "limit": 3,
        "categories": [
          "threat-intelligence"
        ]
      },
      "commercial-intel": {
        "name": "Commercial Intelligence",
        "limit": 2,
        "categories": [
          "commercial-intel"
        ]
      },
      "geoint": {
        "name": "Geospatial & Satellite",
        "limit": 2,
        "categories": [
          "geoint"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 1
  }
}
