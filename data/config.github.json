{
  "ai": {
    "provider": "openai",
    "model": "nvidia/nemotron-3-ultra-550b-a55b:free",
    "base_url": "https://openrouter.ai/api/v1",
    "api_key_env": "OPENROUTER_API_KEY",
    "extra_body": {
      "models": [
        "nvidia/nemotron-3-ultra-550b-a55b:free",
        "google/gemma-4-31b-it:free",
        "google/gemma-4-26b-a4b-it:free"
      ]
    },
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 3,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-lite",
    "profile_settings": {
      "tech-lite": {
        "threshold": 6.5,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "profile": "tech-lite"
      },
      {
        "type": "repo_releases",
        "owner": "ollama",
        "repo": "ollama",
        "enabled": true,
        "profile": "tech-lite"
      },
      {
        "type": "repo_releases",
        "owner": "huggingface",
        "repo": "transformers",
        "enabled": true,
        "profile": "tech-lite"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 20,
      "min_score": 150,
      "profile": "tech-lite"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "tech-lite",
        "fetch_limit": 3
      },
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "ai-labs",
        "profile": "tech-lite",
        "fetch_limit": 2
      },
      {
        "name": "Google DeepMind Blog",
        "url": "https://deepmind.google/blog/rss.xml",
        "enabled": true,
        "category": "ai-labs",
        "profile": "tech-lite",
        "fetch_limit": 2
      },
      {
        "name": "Google AI Blog",
        "url": "https://blog.google/technology/ai/rss/",
        "enabled": true,
        "category": "ai-labs",
        "profile": "tech-lite",
        "fetch_limit": 2
      },
      {
        "name": "Hugging Face Blog",
        "url": "https://huggingface.co/blog/feed.xml",
        "enabled": true,
        "category": "open-source-ai",
        "profile": "tech-lite",
        "fetch_limit": 2
      },
      {
        "name": "MIT Technology Review AI",
        "url": "https://www.technologyreview.com/topic/artificial-intelligence/feed",
        "enabled": true,
        "category": "ai-industry",
        "profile": "tech-lite",
        "fetch_limit": 2
      },
      {
        "name": "TechCrunch AI",
        "url": "https://techcrunch.com/category/artificial-intelligence/feed/",
        "enabled": true,
        "category": "ai-industry",
        "profile": "tech-lite",
        "fetch_limit": 3
      },
      {
        "name": "InfoQ 中文",
        "url": "https://www.infoq.cn/feed",
        "enabled": true,
        "category": "tech-china",
        "fetch_limit": 2,
        "profile": "tech-lite"
      },
      {
        "name": "GitHub Blog",
        "url": "https://github.blog/feed/",
        "enabled": true,
        "category": "developer-tools",
        "profile": "tech-lite",
        "fetch_limit": 1
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 5,
          "min_score": 150,
          "profile": "tech-lite"
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": [
        "All"
      ],
      "keywords": [],
      "min_stars": 50,
      "max_items": 4,
      "profile": "tech-lite"
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 8,
    "profile_order": [
      "tech-lite"
    ],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  }
}
